EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_key
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.7
EXPO_PUBLIC_STORYBOOK_ENABLED=false
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_DIRECT_URL=https://your-project-ref.supabase.co

# Assistant feature flags
EXPO_PUBLIC_ASSISTANT_SERVER_VOICE_ENABLED=true
EXPO_PUBLIC_ASSISTANT_MEMORY_ENABLED=true
EXPO_PUBLIC_ASSISTANT_RAG_ENABLED=true
EXPO_PUBLIC_ASSISTANT_PROVIDER_FALLBACK_ENABLED=true
EXPO_PUBLIC_ASSISTANT_ROUTE_ON_SERVER_ENABLED=false

# Assistant model routing
EXPO_PUBLIC_ASSISTANT_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_ASSISTANT_EXTRACTION_MODEL=gpt-4o-mini

# AI gateway (server) voice defaults
# Set these as Supabase function secrets (not Expo envs):
# SARVAM_API_KEY=your_sarvam_api_key
# OPENAI_API_KEY=your_openai_api_key (server-side, distinct from EXPO_PUBLIC_)
# ASSISTANT_SARVAM_STT_MODEL=saarika:v2.5
# ASSISTANT_SARVAM_TTS_MODEL=bulbul:v3
# ASSISTANT_SARVAM_TTS_EN_SPEAKER=shubh
# ASSISTANT_SARVAM_TTS_HI_SPEAKER=shubh
# ASSISTANT_SARVAM_TTS_MR_SPEAKER=shubh
# ASSISTANT_SARVAM_TTS_PACE=1
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
