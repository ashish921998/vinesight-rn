.claude/
.expo/
.gstack/
.kotlin/
.metro-health-check*
.env
.env.*
!.env.example
# Exclude the generated native dirs entirely so EAS prebuilds fresh from
# app.config (CNG). A stale local android/ otherwise makes EAS skip prebuild
# and ignore config such as android.googleServicesFile (which breaks FCM push).
/android
/ios
dist/
web-build/
google-service-account.json
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
