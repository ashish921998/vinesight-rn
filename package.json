{
  "name": "vinesight-rn",
  "_dependencyNotes": "For Expo SDK 54.0.31 compatibility, run: npx expo install expo-blur expo-constants expo-document-picker expo-file-system expo-font expo-image-picker expo-linear-gradient. Pin openai to >=5.20.0. react-native-markdown-display should be tested against React Native 0.81. Run npx expo install react-native-webview to ensure compatibility.",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "generate-widget": "node scripts/generate-widget.js",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "web:smoke": "CI=1 expo export --platform web --output-dir /tmp/vinesight-web-smoke",
    "test:widgets": "jest --testPathPattern=components/widgets",
    "test:widgets:watch": "jest --watch --testPathPattern=components/widgets",
    "test:widgets:coverage": "jest --coverage --testPathPattern=components/widgets",
    "prepare": "husky",
    "build:android:preview:local": "eas build --platform android --profile preview --local",
    "build:android:production:local": "eas build --platform android --profile production --local",
    "build:android:dev:local": "eas build --platform android --profile development --local",
    "storybook-generate": "sb-rn-get-stories"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~54.0.32",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-blur": "^15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "^18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "^8.0.11",
    "expo-localization": "~17.0.8",
    "expo-location": "^19.0.8",
    "expo-notifications": "^0.32.16",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.22",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "^14.0.8",
    "expo-speech-recognition": "^3.1.0",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.0",
    "openai": "^6.16.0",
    "posthog-js": "^1.336.4",
    "posthog-react-native": "^4.27.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.81.5",
    "react-native-blob-util": "0.21.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pdf": "6.7.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-ondevice-actions": "^10.2.1",
    "@storybook/addon-ondevice-controls": "^10.2.1",
    "@storybook/react-native": "^10.2.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "^54.0.16",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-native-worklets": "0.5.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.53.1"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-webview"
      ]
    }
  }
}
