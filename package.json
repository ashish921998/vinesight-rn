{
  "name": "vinesight-rn",
  "_dependencyNotes": "For Expo SDK 54.0.31 compatibility, run: npx expo install expo-blur expo-constants expo-document-picker expo-file-system expo-font expo-image-picker expo-linear-gradient. Pin openai to >=5.20.0. react-native-markdown-display should be tested against React Native 0.81. Run npx expo install react-native-webview to ensure compatibility.",
  "version": "1.6.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "generate-widget": "node scripts/generate-widget.js",
    "storybook:start": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "web:smoke": "CI=1 expo export --platform web --output-dir /tmp/vinesight-web-smoke",
    "test:widgets": "jest --testPathPattern=components/widgets",
    "test:widgets:watch": "jest --watch --testPathPattern=components/widgets",
    "test:widgets:coverage": "jest --coverage --testPathPattern=components/widgets",
    "prepare": "husky",
    "build:android:preview:local": "eas build --platform android --profile preview --local",
    "build:android:production:local": "eas build --platform android --profile production --local",
    "build:android:dev:local": "eas build --platform android --profile development --local",
    "storybook-generate": "sb-rn-get-stories"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  },
  "dependencies": {
