{
  "name": "vinesight-rn",
  "_dependencyNotes": "Dependencies are aligned with Expo SDK 57. Run npx expo install --check and npx expo-doctor after changing native packages.",
  "version": "1.7.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type files,dependencies --allow-remove-files",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "import:label-claims": "node --experimental-strip-types scripts/import-chemical-label-claims.ts",
    "generate-widget": "node scripts/generate-widget.js",
    "storybook:start": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "web:smoke": "CI=1 expo export --platform web --output-dir /tmp/vinesight-web-smoke",
    "test:widgets": "jest --testPathPattern=components/widgets",
    "test:widgets:watch": "jest --watch --testPathPattern=components/widgets",
    "test:widgets:coverage": "jest --coverage --testPathPattern=components/widgets",
    "prepare": "husky",
    "build:android:preview:local": "eas build --platform android --profile preview --local",
    "build:android:production:local": "eas build --platform android --profile production --local",
    "build:android:dev:local": "eas build --platform android --profile development --local",
    "update:staging": "eas update --branch staging",
    "update:production": "eas update --branch production",
    "storybook-generate": "sb-rn-get-stories"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.3",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rnrepo/expo-config-plugin": "^0.3.5",
    "@sentry/react-native": "^8.20.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.6",
    "expo-audio": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.6",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.6",
    "expo-observe": "~57.0.7",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.6",
    "expo-speech": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.1",
    "fflate": "^0.8.2",
    "i18next": "^25.8.0",
    "openai": "^6.16.0",
    "posthog-js": "^1.336.4",
    "posthog-react-native": "^4.27.0",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.7.4",
    "react-native": "0.86.0",
    "react-native-blob-util": "0.21.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-pdf": "7.0.3",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "storybook": "^10.2.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-ondevice-actions": "^10.2.1",
    "@storybook/addon-ondevice-controls": "^10.2.1",
    "@storybook/react-native": "^10.2.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "knip": "^6.27.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-native-worklets": "0.10.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.55.0"
  },
  "private": true,
  "license": "MIT",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@bacons/apple-targets"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native-webview",
        "typescript"
      ]
    }
  }
}
