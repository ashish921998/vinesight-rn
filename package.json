{
  "name": "vinesight-rn",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "generate-widget": "node scripts/generate-widget.js",
    "storybook:start": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "web:smoke": "CI=1 expo export --platform web --output-dir /tmp/vinesight-web-smoke",
    "test:widgets": "jest --testPathPattern=components/widgets",
    "test:widgets:watch": "jest --watch --testPathPattern=components/widgets",
    "test:widgets:coverage": "jest --coverage --testPathPattern=components/widgets",
    "prepare": "husky",
    "build:android:preview:local": "eas build --platform android --profile preview --local",
    "build:android:production:local": "eas build --platform android --profile production --local",
    "build:android:dev:local": "eas build --platform android --profile development --local",
    "storybook-generate": "sb-rn-get-stories"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "expo": "~55.0.4",
    "expo-apple-authentication": "~55.0.8",
    "expo-application": "~55.0.8",
    "expo-asset": "~55.0.8",
    "expo-audio": "~55.0.8",
    "expo-blur": "~55.0.8",
    "expo-build-properties": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image-picker": "~55.0.10",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-location": "~55.1.2",
    "expo-notifications": "~55.0.10",
    "expo-print": "~55.0.8",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-speech": "~55.0.8",
    "expo-speech-recognition": "^3.1.0",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-web-browser": "~55.0.9",
    "i18next": "^25.8.0",
    "openai": "^6.16.0",
    "posthog-js": "^1.336.4",
    "posthog-react-native": "^4.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.83.2",
    "react-native-blob-util": "0.21.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.26.20",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pdf": "7.0.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-shared-group-preferences": "^1.1.24",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "storybook": "^10.2.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-ondevice-actions": "^10.2.1",
    "@storybook/addon-ondevice-controls": "^10.2.1",
    "@storybook/react-native": "^10.2.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "babel-preset-expo": "~55.0.8",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react-native-worklets": "0.7.2",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.55.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-shared-group-preferences",
          "@bacons/apple-targets"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native-webview"
      ]
    }
  }
}
