# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.cer
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
google-service-account.json

# Firebase / FCM Android config (supply via EAS file env var GOOGLE_SERVICES_JSON)
google-services.json

# signing / credentials (never commit)
authkey.php
AuthKey*.p8
Certificates*.p12

# lint results
lint-results.json
*-results.json

# RNRepo pre-built artifact cache (downloaded at build time; not source)
**/.rnrepo-cache/

# Storybook
*storybook.log
storybook-static

# local IDE/agent files
.idea/
.claude/
agent-orchestrator.yaml
.gstack/
.worktrees/
.codex/
.cursor/
.opencode/
.mcp.json
opencode.json
skills-lock.json

# Xcode local env (machine-specific paths)
ios/.xcode.env.local
.agents

# App Store screenshot upload staging (generated by upload-to-asc.sh)
store/screenshots/upload/
