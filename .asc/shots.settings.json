{
  "version": 1,
  "app": {
    "bundle_id": "com.vinesight.ios",
    "project": "ios/Vinesight.xcworkspace",
    "scheme": "Vinesight",
    "simulator_udid": "booted",
    "simulator_name": "iPhone 17 Pro Max"
  },
  "paths": {
    "plan": ".asc/screenshots.json",
    "raw_dir": "./screenshots/raw",
    "framed_dir": "./screenshots/framed",
    "review_dir": "./screenshots/review"
  },
  "pipeline": {
    "frame_enabled": true,
    "upload_enabled": false,
    "frame_device": "iphone-17-pro-max",
    "frame_background": "#FFFFFF",
    "caption_color": "#173D2D",
    "caption_font": "/System/Library/Fonts/SFNS.ttf",
    "locale": "en-US"
  },
  "upload": {
    "version_localization_id": "",
    "device_type": "IPHONE_69",
    "source_dir": "./screenshots/framed"
  }
}
