, 0.1)' }","line":250,"column":18,"nodeType":"ObjectExpression","endLine":250,"endColumn":63},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: 'rgba(64, 128, 89, 0.1)' }","line":250,"column":18,"nodeType":"ObjectExpression","endLine":250,"endColumn":63},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: '#000000' }","line":256,"column":18,"nodeType":"ObjectExpression","endLine":256,"endColumn":38},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: '#000000' }","line":256,"column":18,"nodeType":"ObjectExpression","endLine":256,"endColumn":38},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: '#8e8e93' }","line":262,"column":18,"nodeType":"ObjectExpression","endLine":262,"endColumn":38},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: '#8e8e93' }","line":262,"column":18,"nodeType":"ObjectExpression","endLine":262,"endColumn":38},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: '#408059' }","line":268,"column":18,"nodeType":"ObjectExpression","endLine":268,"endColumn":48},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: '#408059' }","line":268,"column":18,"nodeType":"ObjectExpression","endLine":268,"endColumn":48},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: '#f2f2f7' }","line":280,"column":14,"nodeType":"ObjectExpression","endLine":280,"endColumn":44},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: '#f2f2f7' }","line":280,"column":14,"nodeType":"ObjectExpression","endLine":280,"endColumn":44},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { paddingTop: 16, paddingBottom: 100, flexGrow: 1 }","line":286,"column":32,"nodeType":"ObjectExpression","endLine":290,"endColumn":10},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  backgroundColor: '#408059',\n  shadowColor: '#000000',\n  shadowOpacity: 0.3,\n  shadowRadius: 8,\n  elevation: 8\n}","line":309,"column":18,"nodeType":"ObjectExpression","endLine":316,"endColumn":12},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: '#408059', shadowColor: '#000000' }","line":309,"column":18,"nodeType":"ObjectExpression","endLine":316,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":43,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\nimport {\n  View,\n  Text,\n  FlatList,\n  TouchableOpacity,\n  RefreshControl,\n  TextInput,\n  ActivityIndicator,\n  Alert,\n} from 'react-native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useRouter } from 'expo-router';\nimport { useFarms, useDeleteFarm } from '@/hooks';\nimport { FarmCard } from '@/components/cards';\nimport type { Farm } from '@/types';\n\nexport default function FarmsScreen() {\n  const router = useRouter();\n  const { data: farms, isLoading, refetch } = useFarms();\n  const deleteFarm = useDeleteFarm();\n  const [searchQuery, setSearchQuery] = useState('');\n  const [isSearchFocused, setIsSearchFocused] = useState(false);\n\n  // Filter farms based on search query\n  const filteredFarms = useMemo(() => {\n    if (!farms) return [];\n    if (!searchQuery.trim()) return farms;\n    \n    const query = searchQuery.toLowerCase().trim();\n    return farms.filter(farm => \n      farm.name.toLowerCase().includes(query) ||\n      farm.crop?.toLowerCase().includes(query) ||\n      farm.crop_variety?.toLowerCase().includes(query) ||\n      farm.region?.toLowerCase().includes(query)\n    );\n  }, [farms, searchQuery]);\n\n  const handleFarmPress = (farm: Farm) => {\n    if (typeof farm.id !== 'number') return;\n    router.push(`/farm/${farm.id}`);\n  };\n\n  const handleAddFarm = () => {\n    router.push('/farm/add');\n  };\n\n  const handleEditFarm = (farm: Farm) => {\n    if (typeof farm.id !== 'number') return;\n    router.push(`/farm/${farm.id}/edit`);\n  };\n\n  const handleDeleteFarm = (farm: Farm) => {\n    const farmId = farm.id;\n    if (typeof farmId !== 'number') return;\n    Alert.alert(\n      'Delete Farm',\n      `Are you sure you want to delete \"${farm.name}\"? This action cannot be undone and will delete all associated data.`,\n      [\n        {\n          text: 'Cancel',\n          style: 'cancel',\n        },\n        {\n          text: 'Delete',\n          style: 'destructive',\n          onPress: async () => {\n            try {\n              await deleteFarm.mutateAsync(farmId);\n            } catch (error: unknown) {\n              const errorMessage = error instanceof Error ? error.message : 'Failed to delete farm';\n              Alert.alert('Error', errorMessage);\n            }\n          },\n        },\n      ]\n    );\n  };\n\n  const renderFarm = ({ item }: { item: Farm }) => (\n    <View className=\"px-4 mb-3\">\n      <FarmCard\n        farm={item}\n        onPress={() => handleFarmPress(item)}\n        onEdit={() => handleEditFarm(item)}\n        onDelete={() => handleDeleteFarm(item)}\n      />\n    </View>\n  );\n\n  const renderHeader = () => (\n    <View className=\"px-4 pb-4\">\n      {/* Search Bar */}\n      <View \n        className={`\n          flex-row items-center bg-white rounded-xl px-4 py-3\n          border ${isSearchFocused ? 'border-primary-500' : 'border-gray-200'}\n        `}\n      >\n        <Ionicons \n          name=\"search-outline\" \n          size={20} \n          color={isSearchFocused ? '#408059' : '#c7c7cc'} \n        />\n        <TextInput\n          className=\"flex-1 ml-3 text-base\"\n          style={{ color: '#000000' }}\n          placeholder=\"Search farms...\"\n          placeholderTextColor=\"#c7c7cc\"\n          value={searchQuery}\n          onChangeText={setSearchQuery}\n          onFocus={() => setIsSearchFocused(true)}\n          onBlur={() => setIsSearchFocused(false)}\n          returnKeyType=\"search\"\n        />\n        {searchQuery.length > 0 && (\n          <TouchableOpacity\n            onPress={() => setSearchQuery('')}\n            hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}\n          >\n            <Ionicons name=\"close-circle\" size={20} color=\"#c7c7cc\" />\n          </TouchableOpacity>\n        )}\n      </View>\n\n      {/* Results Count */}\n      {searchQuery.trim() && (\n        <Text className=\"text-sm mt-3\" style={{ color: '#8e8e93' }}>\n          {filteredFarms.length} farm{filteredFarms.length !== 1 ? 's' : ''} found\n        </Text>\n      )}\n\n      {/* Quick Stats */}\n      {!searchQuery.trim() && farms && farms.length > 0 && (\n        <View className=\"flex-row mt-4 gap-3\">\n          <View \n            className=\"flex-1 rounded-xl p-3\"\n            style={{ backgroundColor: '#ffffff' }}\n          >\n            <View className=\"flex-row items-center\">\n              <View \n                className=\"w-8 h-8 rounded-lg items-center justify-center\"\n                style={{ backgroundColor: 'rgba(64, 128, 89, 0.1)' }}\n              >\n                <Ionicons name=\"leaf\" size={16} color=\"#408059\" />\n              </View>\n              <View className=\"ml-2\">\n                <Text \n                  className=\"text-lg font-bold\"\n                  style={{ color: '#000000' }}\n                >\n                  {farms.length}\n                </Text>\n                <Text \n                  className=\"text-xs\"\n                  style={{ color: '#8e8e93' }}\n                >\n                  Total Farms\n                </Text>\n              </View>\n            </View>\n          </View>\n          <View \n            className=\"flex-1 rounded-xl p-3\"\n            style={{ backgroundColor: '#ffffff' }}\n          >\n            <View className=\"flex-row items-center\">\n              <View \n                className=\"w-8 h-8 rounded-lg items-center justify-center\"\n                style={{ backgroundColor: 'rgba(64, 128, 89, 0.1)' }}\n              >\n                <Ionicons name=\"resize\" size={16} color=\"#408059\" />\n              </View>\n              <View className=\"ml-2\">\n                <Text \n                  className=\"text-lg font-bold\"\n                  style={{ color: '#000000' }}\n                >\n                  {farms.reduce((sum, f) => sum + (f.area || 0), 0).toFixed(1)}\n                </Text>\n                <Text \n                  className=\"text-xs\"\n                  style={{ color: '#8e8e93' }}\n                >\n                  Total Acres\n                </Text>\n              </View>\n            </View>\n          </View>\n        </View>\n      )}\n    </View>\n  );\n\n  const renderEmpty = () => {\n    if (isLoading) {\n      return (\n        <View className=\"flex-1 items-center justify-center p-8\">\n          <ActivityIndicator size=\"large\" color=\"#408059\" />\n          <Text \n            className=\"text-base mt-4\"\n            style={{ color: '#8e8e93' }}\n          >\n            Loading farms...\n          </Text>\n        </View>\n      );\n    }\n\n    if (searchQuery.trim()) {\n      return (\n        <View className=\"flex-1 items-center justify-center p-8\">\n          <View \n            className=\"w-20 h-20 rounded-full items-center justify-center mb-4\"\n            style={{ backgroundColor: '#f2f2f7' }}\n          >\n            <Ionicons name=\"search-outline\" size={36} color=\"#c7c7cc\" />\n          </View>\n          <Text \n            className=\"text-lg font-semibold text-center\"\n            style={{ color: '#000000' }}\n          >\n            No Results Found\n          </Text>\n          <Text \n            className=\"text-base text-center mt-2\"\n            style={{ color: '#8e8e93' }}\n          >\n            Try a different search term\n          </Text>\n          <TouchableOpacity \n            onPress={() => setSearchQuery('')}\n            className=\"mt-4\"\n          >\n            <Text \n              className=\"font-medium\"\n              style={{ color: '#408059' }}\n            >\n              Clear Search\n            </Text>\n          </TouchableOpacity>\n        </View>\n      );\n    }\n\n    return (\n      <View className=\"flex-1 items-center justify-center p-8\">\n        <View \n          className=\"w-24 h-24 rounded-full items-center justify-center mb-6\"\n          style={{ backgroundColor: 'rgba(64, 128, 89, 0.1)' }}\n        >\n          <Ionicons name=\"leaf-outline\" size={48} color=\"#408059\" />\n        </View>\n        <Text \n          className=\"text-xl font-semibold text-center\"\n          style={{ color: '#000000' }}\n        >\n          No Farms Yet\n        </Text>\n        <Text \n          className=\"text-base text-center mt-2\"\n          style={{ color: '#8e8e93' }}\n        >\n          Add your first farm to start tracking irrigation, sprays, and harvests.\n        </Text>\n        <TouchableOpacity \n          className=\"px-6 py-3 rounded-xl mt-6\"\n          style={{ backgroundColor: '#408059' }}\n          onPress={handleAddFarm}\n        >\n          <Text className=\"text-white font-semibold\">Add Farm</Text>\n        </TouchableOpacity>\n      </View>\n    );\n  };\n\n  return (\n    <View\n      className=\"flex-1\"\n      style={{ backgroundColor: '#f2f2f7' }}\n    >\n      <FlatList\n        data={filteredFarms}\n        renderItem={renderFarm}\n        keyExtractor={(item) => String(item.id)}\n        contentContainerStyle={{\n          paddingTop: 16,\n          paddingBottom: 100,\n          flexGrow: 1,\n        }}\n        ListHeaderComponent={renderHeader}\n        ListEmptyComponent={renderEmpty}\n        refreshControl={\n          <RefreshControl\n            refreshing={isLoading && !searchQuery}\n            onRefresh={refetch}\n            tintColor=\"#408059\"\n          />\n        }\n        showsVerticalScrollIndicator={false}\n      />\n\n      {/* FAB */}\n      {(farms?.length || 0) > 0 && (\n        <TouchableOpacity\n          className=\"absolute bottom-6 right-6 w-14 h-14 rounded-full items-center justify-center\"\n          activeOpacity={0.8}\n          onPress={handleAddFarm}\n          style={{\n            backgroundColor: '#408059',\n            shadowColor: '#000000',\n            shadowOffset: { width: 0, height: 4 },\n            shadowOpacity: 0.3,\n            shadowRadius: 8,\n            elevation: 8,\n          }}\n        >\n          <Ionicons name=\"add\" size={28} color=\"#FFFFFF\" />\n        </TouchableOpacity>\n      )}\n    </View>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/ashishhuddar/Desktop/vinesight-rn/app/(tabs)/index.tsx","messages":[{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: '#f2f2f7' }","line":76,"column":14,"nodeType":"ObjectExpression","endLine":76,"endColumn":44},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: '#f2f2f7' }","line":76,"column":14,"nodeType":"ObjectExpression","endLine":76,"endColumn":44},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { paddingBottom: 100 }","line":77,"column":30,"nodeType":"ObjectExpression","endLine":77,"endColumn":52},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: '#000000' }","line":91,"column":20,"nodeType":"ObjectExpression","endLine":91,"endColumn":40},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: '#000000' }","line":91,"column":20,"nodeType":"ObjectExpression","endLine":91,"endColumn":40},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inlin