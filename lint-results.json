ing}\n              className={`flex-1 flex-row items-center justify-center p-4 rounded-xl ${\n                !preview || isExporting ? 'bg-gray-200' : 'bg-red-500'\n              }`}\n            >\n              {isExporting ? (\n                <ActivityIndicator size=\"small\" color=\"#fff\" />\n              ) : (\n                <>\n                  <Ionicons name=\"document\" size={24} color=\"white\" />\n                  <Text className=\"text-white font-bold ml-2\">PDF</Text>\n                </>\n              )}\n            </TouchableOpacity>\n            <TouchableOpacity\n              onPress={() => handleExport('csv')}\n              disabled={!preview || isExporting}\n              className={`flex-1 flex-row items-center justify-center p-4 rounded-xl ${\n                !preview || isExporting ? 'bg-gray-200' : 'bg-green-600'\n              }`}\n            >\n              {isExporting ? (\n                <ActivityIndicator size=\"small\" color=\"#fff\" />\n              ) : (\n                <>\n                  <Ionicons name=\"grid\" size={24} color=\"white\" />\n                  <Text className=\"text-white font-bold ml-2\">CSV</Text>\n                </>\n              )}\n            </TouchableOpacity>\n          </View>\n        </View>\n      </ScrollView>\n    </SafeAreaView>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/ashishhuddar/Desktop/vinesight-rn/app/soil-profiling.tsx","messages":[{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  backgroundColor: 'rgba(255, 255, 255, 0.8)',\n  shadowColor: '#000',\n  shadowOpacity: 0.05,\n  shadowRadius: 5,\n  elevation: 2\n}","line":103,"column":16,"nodeType":"ObjectExpression","endLine":110,"endColumn":10},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: 'rgba(255, 255, 255, 0.8)', shadowColor: '#000' }","line":103,"column":16,"nodeType":"ObjectExpression","endLine":110,"endColumn":10},{