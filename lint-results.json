olor literal: { shadowColor: '#000' }","line":201,"column":30,"nodeType":"ObjectExpression","endLine":207,"endColumn":24},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  color: 'white',\n  paddingHorizontal: 12,\n  paddingVertical: 6,\n  borderRadius: 999\n}","line":228,"column":70,"nodeType":"ObjectExpression","endLine":228,"endColumn":183},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: 'white' }","line":228,"column":70,"nodeType":"ObjectExpression","endLine":228,"endColumn":183},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: 'rgba(0, 0, 0, 0.05)' }","line":243,"column":18,"nodeType":"ObjectExpression","endLine":245,"endColumn":12},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: 'rgba(0, 0, 0, 0.05)' }","line":243,"column":18,"nodeType":"ObjectExpression","endLine":245,"endColumn":12},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { shadowColor: '#000', shadowOpacity: 0.1, shadowRadius: 4 }","line":256,"column":21,"nodeType":"ObjectExpression","endLine":261,"endColumn":22},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { shadowColor: '#000' }","line":256,"column":21,"nodeType":"ObjectExpression","endLine":261,"endColumn":22},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { shadowColor: '#000', shadowOpacity: 0.06, shadowRadius: 12 }","line":284,"column":20,"nodeType":"ObjectExpression","endLine":290,"endColumn":14},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { shadowColor: '#000' }","line":284,"column":20,"nodeType":"ObjectExpression","endLine":290,"endColumn":14},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  borderColor: \"isLowStock ? `${COLORS.lowStock}4D` : 'transparent'\",\n  borderWidth: 'isLowStock ? 1 : 0',\n  shadowColor: '#000',\n  shadowOpacity: 0.06,\n  shadowRadius: 12\n}","line":325,"column":24,"nodeType":"ObjectExpression","endLine":333,"endColumn":18},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: {\n  borderColor: \"isLowStock ? `${COLORS.lowStock}4D` : 'transparent'\",\n  shadowColor: '#000'\n}","line":325,"column":24,"nodeType":"ObjectExpression","endLine":333,"endColumn":18},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { shadowOpacity: 0.4, shadowRadius: 8, elevation: 8 }","line":452,"column":16,"nodeType":"ObjectExpression","endLine":459,"endColumn":10}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":23,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\nimport {\n  View,\n  Text,\n  ScrollView,\n  TouchableOpacity,\n  ActivityIndicator,\n  Alert,\n  RefreshControl,\n} from 'react-native';\nimport { router, Stack } from 'expo-router';\nimport { Ionicons } from '@expo/vector-icons';\nimport { SafeAreaView } from 'react-native-safe-area-context';\nimport {\n  useWarehouseItems,\n  useDeleteWarehouseItem,\n  useProfile,\n} from '../src/hooks';\nimport { WarehouseItem } from '../src/types';\nimport AddWarehouseItemModal from '../src/components/screens/AddWarehouseItemModal';\nimport AddStockModal from '../src/components/screens/AddStockModal';\n\ntype FilterType = 'all' | 'fertilizer' | 'spray';\n\nconst COLORS = {\n  primary: '#408059',\n  background: '#f2f2f7',\n  glass: 'rgba(255, 255, 255, 0.8)',\n  lowStock: '#D9731F',\n  warehouseFertilizer: '#598C6B',\n  warehouseSpray: '#408059',\n};\n\nexport default function WarehouseScreen() {\n  const { data: profile } = useProfile();\n  const { data: items, isLoading, refetch, isRefetching } = useWarehouseItems();\n  const deleteItemMutation = useDeleteWarehouseItem();\n\n  const [filter, setFilter] = useState<FilterType>('all');\n  const [showAddModal, setShowAddModal] = useState(false);\n  const [showStockModal, setShowStockModal] = useState(false);\n  const [editingItem, setEditingItem] = useState<WarehouseItem | null>(null);\n  const [stockItem, setStockItem] = useState<WarehouseItem | null>(null);\n\n  const currency = profile?.preferred_currency || 'INR';\n\n  // Filter items\n  const filteredItems = useMemo(() => {\n    if (!items) return [];\n    if (filter === 'all') return items;\n    return items.filter((item) => item.type === filter);\n  }, [items, filter]);\n\n  // Low stock items\n  const lowStockItems = useMemo(() => {\n    if (!items) return [];\n    return items.filter(\n      (item) => item.reorder_quantity && item.quantity <= item.reorder_quantity\n    );\n  }, [items]);\n\n  // Calculate totals\n  const totals = useMemo(() => {\n    if (!items) return { count: 0, value: 0, fertilizers: 0, sprays: 0 };\n    return {\n      count: items.length,\n      value: items.reduce((sum, item) => sum + item.quantity * item.unit_price, 0),\n      fertilizers: items.filter((item) => item.type === 'fertilizer').length,\n      sprays: items.filter((item) => item.type === 'spray').length,\n    };\n  }, [items]);\n\n  const handleDeleteItem = (item: WarehouseItem) => {\n    Alert.alert(\n      'Delete Item',\n      `Are you sure you want to delete \"${item.name}\"?`,\n      [\n        { text: 'Cancel', style: 'cancel' },\n        {\n          text: 'Delete',\n          style: 'destructive',\n          onPress: () => {\n            if (item.id) {\n              deleteItemMutation.mutate(item.id);\n            }\n          },\n        },\n      ]\n    );\n  };\n\n  const handleAddStock = (item: WarehouseItem) => {\n    setStockItem(item);\n    setShowStockModal(true);\n  };\n\n  const handleEditItem = (item: WarehouseItem) => {\n    setEditingItem(item);\n    setShowAddModal(true);\n  };\n\n  if (isLoading) {\n    return (\n      <SafeAreaView style={{ flex: 1, backgroundColor: COLORS.background, justifyContent: 'center', alignItems: 'center' }} edges={['top']}>\n        <Stack.Screen options={{ title: 'Warehouse' }} />\n        <ActivityIndicator size=\"large\" color={COLORS.primary} />\n        <Text className=\"text-surface-600 mt-4\">Loading inventory...</Text>\n      </SafeAreaView>\n    );\n  }\n\n  return (\n    <View className=\"flex-1\" style={{ backgroundColor: COLORS.background }}>\n      <Stack.Screen\n        options={{\n          title: 'Warehouse',\n          headerRight: () => (\n            <TouchableOpacity\n              onPress={() => {\n                setEditingItem(null);\n                setShowAddModal(true);\n              }}\n              className=\"mr-4\"\n            >\n              <Ionicons name=\"add-circle\" size={28} color=\"#408059\" />\n            </TouchableOpacity>\n          ),\n        }}\n      />\n\n      <SafeAreaView style={{ flex: 1 }} edges={['top']}>\n        <ScrollView\n          contentContainerStyle={{ paddingHorizontal: 16, paddingBottom: 100 }}\n          refreshControl={\n            <RefreshControl refreshing={isRefetching} onRefresh={refetch} tintColor={COLORS.primary} />\n          }\n        >\n        {/* Summary Cards */}\n        <View className=\"flex-row mb-4\" style={{ gap: 12 }}>\n          <View\n            className=\"flex-1 rounded-2xl p-4\"\n            style={{\n              backgroundColor: COLORS.glass,\n              shadowColor: '#000',\n              shadowOffset: { width: 0, height: 6 },\n              shadowOpacity: 0.06,\n              shadowRadius: 12,\n            }}\n          >\n            <Ionicons\n              name=\"warning\"\n              size={24}\n              color={lowStockItems.length > 0 ? COLORS.lowStock : COLORS.primary}\n            />\n            <Text className=\"text-2xl font-bold text-surface-900 mt-2\">{lowStockItems.length}</Text>\n            <Text className=\"text-xs text-surface-500\">Low Stock</Text>\n          </View>\n          <View\n            className=\"flex-1 rounded-2xl p-4\"\n            style={{\n              backgroundColor: COLORS.glass,\n              shadowColor: '#000',\n              shadowOffset: { width: 0, height: 6 },\n              shadowOpacity: 0.06,\n              shadowRadius: 12,\n            }}\n          >\n            <Ionicons name=\"cash\" size={24} color={COLORS.primary} />\n            <Text className=\"text-2xl font-bold text-surface-900 mt-2\">\n              {currency === 'INR' ? '₹' : '$'}\n              {totals.value.toLocaleString()}\n            </Text>\n            <Text className=\"text-xs text-surface-500\">Value</Text>\n          </View>\n        </View>\n\n        {/* Low Stock Alert */}\n        {lowStockItems.length > 0 && (\n          <View className=\"rounded-2xl p-4 mb-4\" style={{ backgroundColor: `${COLORS.lowStock}15` }}>\n            <View className=\"flex-row items-center mb-3\">\n              <Ionicons name=\"warning\" size={20} color={COLORS.lowStock} />\n              <Text className=\"text-base font-semibold ml-2\" style={{ color: COLORS.lowStock }}>\n                Low Stock Alerts\n              </Text>\n              <View className=\"px-2 py-0.5 rounded-full ml-auto\" style={{ backgroundColor: `${COLORS.lowStock}30` }}>\n                <Text className=\"text-xs font-medium\" style={{ color: COLORS.lowStock }}>\n                  {lowStockItems.length} items\n                </Text>\n              </View>\n            </View>\n            <ScrollView horizontal showsHorizontalScrollIndicator={false}>\n              <View className=\"flex-row\" style={{ gap: 12 }}>\n                {lowStockItems.map((item) => (\n                  <TouchableOpacity\n                    key={item.id}\n                    onPress={() => handleAddStock(item)}\n                    style={{ width: 160 }}\n                  >\n                    <View\n                      className=\"rounded-xl p-3\"\n                      style={{\n                        backgroundColor: COLORS.glass,\n                        shadowColor: '#000',\n                        shadowOffset: { width: 0, height: 2 },\n                        shadowOpacity: 0.05,\n                        shadowRadius: 8,\n                      }}\n                    >\n                      <View className=\"flex-row items-center\">\n                        <Ionicons\n                          name={item.type === 'fertilizer' ? 'leaf' : 'water'}\n                          size={16}\n                          color={COLORS.lowStock}\n                        />\n                        <Text className=\"text-sm font-semibold text-surface-900 ml-2\" numberOfLines={1}>\n                          {item.name}\n                        </Text>\n                      </View>\n                      <Text className=\"text-xs text-surface-600 mt-1\">\n                        {item.quantity} {item.unit}\n                      </Text>\n                      {item.reorder_quantity && (\n                        <Text className=\"text-xs text-surface-500 mt-0.5\">\n                          Reorder at: {item.reorder_quantity} {item.unit}\n                        </Text>\n                      )}\n                      <View className=\"mt-2 py-1.5 px-3 rounded-full items-center self-start\">\n                        <Text className=\"text-xs font-medium\" style={{ color: 'white', backgroundColor: COLORS.primary, paddingHorizontal: 12, paddingVertical: 6, borderRadius: 999 }}>\n                          Add Stock\n                        </Text>\n                      </View>\n                    </View>\n                  </TouchableOpacity>\n                ))}\n              </View>\n            </ScrollView>\n          </View>\n        )}\n\n        {/* Filter Tabs - Segmented style */}\n        <View\n          className=\"flex-row rounded-xl p-1 mb-4\"\n          style={{\n            backgroundColor: 'rgba(0, 0, 0, 0.05)',\n          }}\n        >\n          {(['all', 'fertilizer', 'spray'] as FilterType[]).map((type) => (\n            <TouchableOpacity\n              key={type}\n              onPress={() => setFilter(type)}\n              className={`flex-1 py-2.5 rounded-lg ${\n                filter === type ? 'bg-white' : ''\n              }`}\n              style={\n                filter === type\n                  ? {\n                      shadowColor: '#000',\n                      shadowOffset: { width: 0, height: 2 },\n                      shadowOpacity: 0.1,\n                      shadowRadius: 4,\n                    }\n                  : {}\n              }\n            >\n              <Text\n                className={`text-center text-sm font-medium ${\n                  filter === type ? 'text-surface-900' : 'text-surface-600'\n                }`}\n              >\n                {type === 'all'\n                  ? `ALL (${totals.count})`\n                  : type === 'fertilizer'\n                  ? `FERTILIZERS (${totals.fertilizers})`\n                  : `SPRAYS (${totals.sprays})`}\n              </Text>\n            </TouchableOpacity>\n          ))}\n        </View>\n\n        {/* Inventory List */}\n        {filteredItems.length === 0 ? (\n          <View\n            className=\"rounded-2xl p-8 items-center\"\n            style={{\n              backgroundColor: COLORS.glass,\n              shadowColor: '#000',\n              shadowOffset: { width: 0, height: 6 },\n              shadowOpacity: 0.06,\n              shadowRadius: 12,\n            }}\n          >\n            <View\n              className=\"w-16 h-16 rounded-full items-center justify-center\"\n              style={{ backgroundColor: `${COLORS.primary}33` }}\n            >\n              <Ionicons name=\"cube-outline\" size={32} color={COLORS.primary} />\n            </View>\n            <Text className=\"text-surface-900 font-semibold mt-4 text-center\">No items in warehouse</Text>\n            <Text className=\"text-surface-500 text-sm mt-1 text-center\">\n              Tap the + button to add your first inventory item\n            </Text>\n            <TouchableOpacity\n              onPress={() => {\n                setEditingItem(null);\n                setShowAddModal(true);\n              }}\n              className=\"mt-4 px-6 py-3 rounded-xl flex-row items-center\"\n              style={{ backgroundColor: COLORS.primary }}\n            >\n              <Ionicons name=\"add-circle\" size={20} color=\"white\" />\n              <Text className=\"text-white font-semibold ml-2\">Add Item</Text>\n            </TouchableOpacity>\n          </View>\n        ) : (\n          filteredItems.map((item) => {\n            const isLowStock = item.reorder_quantity && item.quantity <= item.reorder_quantity;\n            const itemValue = item.quantity * item.unit_price;\n            const itemColor =\n              item.type === 'fertilizer' ? COLORS.warehouseFertilizer : COLORS.warehouseSpray;\n\n            return (\n              <View\n                key={item.id}\n                className=\"rounded-2xl p-4 mb-3\"\n                style={{\n                  backgroundColor: isLowStock ? `${COLORS.lowStock}0D` : COLORS.glass,\n                  borderColor: isLowStock ? `${COLORS.lowStock}4D` : 'transparent',\n                  borderWidth: isLowStock ? 1 : 0,\n                  shadowColor: '#000',\n                  shadowOffset: { width: 0, height: 6 },\n                  shadowOpacity: 0.06,\n                  shadowRadius: 12,\n                }}\n              >\n                <View className=\"flex-row items-start\">\n                  <View className=\"flex-1\">\n                    <View className=\"flex-row items-center\">\n                      <View\n                        className=\"px-2.5 py-1 rounded-full\"\n                        style={{\n                          backgroundColor:\n                            item.type === 'fertilizer'\n                              ? `${COLORS.warehouseFertilizer}33`\n                              : `${COLORS.warehouseSpray}33`,\n                        }}\n                      >\n                        <View className=\"flex-row items-center\">\n                          <Ionicons\n                            name={item.type === 'fertilizer' ? 'leaf' : 'water'}\n                            size={12}\n                            color={itemColor}\n                          />\n                          <Text\n                            className=\"text-xs font-medium ml-1\"\n                            style={{ color: itemColor }}\n                          >\n                            {item.type === 'fertilizer' ? 'FERTILIZER' : 'SPRAY'}\n                          </Text>\n                        </View>\n                      </View>\n                      {isLowStock && (\n                        <View\n                          className=\"ml-2 px-2 py-0.5 rounded-full\"\n                          style={{ backgroundColor: `${COLORS.lowStock}33` }}\n                        >\n                          <Text\n                            className=\"text-xs font-medium\"\n                            style={{ color: COLORS.lowStock }}\n                          >\n                            Low\n                          </Text>\n                        </View>\n                      )}\n                      <TouchableOpacity\n                        onPress={() => {\n                          Alert.alert(\n                            'Actions',\n                            `${item.name}`,\n                            [\n                              {\n                                text: 'Add Stock',\n                                onPress: () => handleAddStock(item),\n                              },\n                              {\n                                text: 'Edit',\n                                onPress: () => handleEditItem(item),\n                              },\n                              {\n                                text: 'Delete',\n                                style: 'destructive',\n                                onPress: () => handleDeleteItem(item),\n                              },\n                              { text: 'Cancel', style: 'cancel' },\n                            ]\n                          );\n                        }}\n                      >\n                        <Ionicons name=\"ellipsis-horizontal-circle\" size={24} color=\"#6B7280\" />\n                      </TouchableOpacity>\n                    </View>\n                    <Text className=\"text-base font-semibold text-surface-900 mt-2\">\n                      {item.name}\n                    </Text>\n                  </View>\n                </View>\n\n                <View className=\"flex-row mt-3\">\n                  <View className=\"flex-1\">\n                    <Text className=\"text-xs text-surface-500\">Quantity</Text>\n                    <Text className=\"text-sm font-semibold text-surface-900\">\n                      {item.quantity} {item.unit}\n                    </Text>\n                  </View>\n                  <View className=\"flex-1 items-center\">\n                    <Text className=\"text-xs text-surface-500\">Unit Price</Text>\n                    <Text className=\"text-sm font-medium text-surface-900\">\n                      {currency === 'INR' ? '₹' : '$'}\n                      {item.unit_price.toLocaleString()}/{item.unit}\n                    </Text>\n                  </View>\n                  <View className=\"flex-1 items-end\">\n                    <Text className=\"text-xs text-surface-500\">Total Value</Text>\n                    <Text\n                      className=\"text-sm font-semibold\"\n                      style={{ color: COLORS.primary }}\n                    >\n                      {currency === 'INR' ? '₹' : '$'}\n                      {itemValue.toLocaleString()}\n                    </Text>\n                  </View>\n                </View>\n\n                {item.notes && (\n                  <Text className=\"text-xs text-surface-600 mt-2\" numberOfLines={2}>\n                    {item.notes}\n                  </Text>\n                )}\n              </View>\n            );\n          })\n        )}\n        </ScrollView>\n      </SafeAreaView>\n\n      {/* FAB */}\n      <TouchableOpacity\n        onPress={() => {\n          setEditingItem(null);\n          setShowAddModal(true);\n        }}\n        className=\"absolute bottom-6 right-6 w-14 h-14 rounded-full items-center justify-center\"\n        style={{\n          backgroundColor: COLORS.primary,\n          shadowColor: COLORS.primary,\n          shadowOffset: { width: 0, height: 6 },\n          shadowOpacity: 0.4,\n          shadowRadius: 8,\n          elevation: 8,\n        }}\n      >\n        <Ionicons name=\"add\" size={28} color=\"white\" />\n      </TouchableOpacity>\n\n      {/* Modals */}\n      <AddWarehouseItemModal\n        visible={showAddModal}\n        onClose={() => {\n          setShowAddModal(false);\n          setEditingItem(null);\n        }}\n        editingItem={editingItem}\n      />\n\n      <AddStockModal\n        visible={showStockModal}\n        onClose={() => {\n          setShowStockModal(false);\n          setStockItem(null);\n        }}\n        item={stockItem}\n      />\n    </View>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/ashishhuddar/Desktop/vinesight-rn/app/weather.tsx","messages":[{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { padding: 16, paddingBottom: 32 }","line":151,"column":30,"nodeType":"ObjectExpression","endLine":151,"endColumn":64},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":226,"column":28,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7366,7547],"text":"\n            This farm doesn&apos;t have location coordinates. Weather data is showing default\n            location (Nashik). Add GPS coordinates to get farm-specific weather.\n          "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7366,7547],"text":"\n            This farm doesn&lsquo;t have location coordinates. Weather data is showing default\n            location (Nashik). Add GPS coordinates to get farm-specific weather.\n          "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7366,7547],"text":"\n            This farm doesn&#39;t have location coordinates. Weather data is showing default\n            location (Nashik). Add GPS coordinates to get farm-specific weather.\n          "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7366,7547],"text":"\n            This farm doesn&rsquo;t have location coordinates. Weather data is showing default\n            location (Nashik). Add GPS coordinates to get farm-specific weather.\n          "},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { gap: 12 }","line":233,"column":46,"nodeType":"ObjectExpression","endLine":233,"endColumn":57},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { maxHeight: 200 }","line":250,"column":34,"nodeType":"ObjectExpression","endLine":250,"endColumn":52},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { gap: 10 }","line":389,"column":36,"nodeType":"ObjectExpression","endLine":389,"endColumn":47},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { width: 80 }","line":397,"column":24,"nodeType":"ObjectExpression","endLine":397,"endColumn":37},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { marginVertical: 8 }","line":410,"column":26,"nodeType":"ObjectExpression","endLine":410,"endColumn":47},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { gap: 12 }","line":441,"column":55,"nodeType":"ObjectExpression","endLine":441,"endColumn":66},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { minWidth: '45%' }","line":442,"column":74,"nodeType":"ObjectExpression","endLine":442,"endColumn":93},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { minWidth: '45%' }","line":447,"column":74,"nodeType":"ObjectExpression","endLine":447,"endColumn":93},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { minWidth: '45%' }","line":453,"column":73,"nodeType":"ObjectExpression","endLine":453,"endColumn":92},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: \"alerts.harvest.isOptimal ? '#DCFCE7' : '#FEF3C7'\" }","line":555,"column":24,"nodeType":"ObjectExpression","endLine":557,"endColumn":18},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: \"alerts.harvest.isOptimal ? '#DCFCE7' : '#FEF3C7'\" }","line":555,"column":24,"nodeType":"ObjectExpression","endLine":557,"endColumn":18},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: \"alerts.harvest.isOptimal ? '#166534' : '#92400E'\" }","line":561,"column":26,"nodeType":"ObjectExpression","endLine":561,"endColumn":85},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: \"alerts.harvest.isOptimal ? '#166534' : '#92400E'\" }","line":561,"column":26,"nodeType":"ObjectExpression","endLine":561,"endColumn":85},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  backgroundColor: \"item.priority === 'high'\\n\" +\n    \"                      ? '#FEE2E2'\\n\" +\n    \"                      : item.priority === 'medium'\\n\" +\n    \"                      ? '#FEF3C7'\\n\" +\n    \"                      : '#DCFCE7'\"\n}","line":588,"column":24,"nodeType":"ObjectExpression","endLine":595,"endColumn":18},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: {\n  backgroundColor: \"item.priority === 'high'\\n\" +\n    \"                      ? '#FEE2E2'\\n\" +\n    \"                      : item.priority === 'medium'\\n\" +\n    \"                      ? '#FEF3C7'\\n\" +\n    \"                      : '#DCFCE7'\"\n}","line":588,"column":24,"nodeType":"ObjectExpression","endLine":595,"endColumn":18}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":16,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useMemo } from 'react';\nimport {\n  View,\n  Text,\n  ScrollView,\n  TouchableOpacity,\n  ActivityIndicator,\n  RefreshControl,\n} from 'react-native';\nimport { Ionicons } from '@expo/vector-icons';\nimport { useFarms } from '../src/hooks';\nimport { useWeatherData } from '../src/hooks/useWeather';\nimport { GrapeGrowthStage, SoilType } from '../src/types/weather';\n\n// Growth stages\nconst GROWTH_STAGES: GrapeGrowthStage[] = [\n  'Budbreak',\n  'Leaf development',\n  'Flowering',\n  'Fruit set',\n  'Veraison',\n  'Harvest',\n  'Post-harvest',\n  'Dormant',\n];\n\n// Soil types\nconst SOIL_TYPES: { value: SoilType; label: string }[] = [\n  { value: 'sandy', label: 'Sandy' },\n  { value: 'medium', label: 'Medium (Loam)' },\n  { value: 'clay', label: 'Clay' },\n];\n\n// Weather condition icons\nfunction getWeatherIconName(conditionCode: number): keyof typeof Ionicons.glyphMap {\n  switch (conditionCode) {\n    case 1000: return 'sunny';\n    case 1003: return 'partly-sunny';\n    case 1006: return 'cloudy';\n    case 1153: return 'rainy';\n    case 1186: return 'rainy';\n    default: return 'cloudy';\n  }\n}\n\n// Urgency badge colors\nconst urgencyColors = {\n  low: { bg: '#DCFCE7', text: '#166534' },\n  medium: { bg: '#FEF3C7', text: '#92400E' },\n  high: { bg: '#FEE2E2', text: '#991B1B' },\n};\n\n// Day name helper\nfunction getDayName(dateString: string): string {\n  const date = new Date(dateString);\n  const today = new Date();\n  const tomorrow = new Date(today);\n  tomorrow.setDate(tomorrow.getDate() + 1);\n\n  if (date.toDateString() === today.toDateString()) return 'Today';\n  if (date.toDateString() === tomorrow.toDateString()) return 'Tomorrow';\n  return date.toLocaleDateString('en-US', { weekday: 'short' });\n}\n\nexport default function WeatherScreen() {\n  const { data: farms, isLoading: farmsLoading } = useFarms();\n  const [selectedFarmId, setSelectedFarmId] = useState<number | null>(null);\n  const [growthStage, setGrowthStage] = useState<GrapeGrowthStage>('Fruit set');\n  const [soilType, setSoilType] = useState<SoilType>('medium');\n  const [showFarmPicker, setShowFarmPicker] = useState(false);\n  const [showGrowthPicker, setShowGrowthPicker] = useState(false);\n  const [showSoilPicker, setShowSoilPicker] = useState(false);\n\n  // Get selected farm coordinates\n  const selectedFarm = useMemo(() => {\n    if (!farms || farms.length === 0) return null;\n    if (selectedFarmId) return farms.find((f) => f.id === selectedFarmId) || farms[0];\n    return farms[0];\n  }, [farms, selectedFarmId]);\n\n  // Fetch weather data\n  const {\n    weather,\n    etc,\n    alerts,\n    irrigationSchedule,\n    isLoading,\n    error,\n    refetch,\n    isRefetching,\n  } = useWeatherData(\n    selectedFarm?.latitude ?? undefined,\n    selectedFarm?.longitude ?? undefined,\n    growthStage,\n    soilType\n  );\n\n  // Set initial farm when farms load\n  React.useEffect(() => {\n    if (farms && farms.length > 0 && !selectedFarmId && farms[0].id !== undefined) {\n      setSelectedFarmId(farms[0].id);\n    }\n  }, [farms, selectedFarmId]);\n\n  if (farmsLoading || isLoading) {\n    return (\n      <View className=\"flex-1 bg-surface-50 items-center justify-center\">\n        <ActivityIndicator size=\"large\" color=\"#408059\" />\n        <Text className=\"text-surface-600 mt-4\">Loading weather data...</Text>\n      </View>\n    );\n  }\n\n  if (error) {\n    return (\n      <View className=\"flex-1 bg-surface-50 items-center justify-center p-6\">\n        <Ionicons name=\"cloud-offline\" size={48} color=\"#9CA3AF\" />\n        <Text className=\"text-surface-600 mt-4 text-center\">\n          Unable to load weather data\n        </Text>\n        <Text className=\"text-surface-500 text-sm mt-2 text-center\">\n          {error.message}\n        </Text>\n        <TouchableOpacity\n          onPress={() => refetch()}\n          className=\"mt-4 bg-primary-600 px-6 py-3 rounded-xl\"\n        >\n          <Text className=\"text-white font-semibold\">Try Again</Text>\n        </TouchableOpacity>\n      </View>\n    );\n  }\n\n  if (!farms || farms.length === 0) {\n    return (\n      <View className=\"flex-1 bg-surface-50 items-center justify-center p-6\">\n        <Ionicons name=\"leaf\" size={48} color=\"#9CA3AF\" />\n        <Text className=\"text-surface-600 mt-4 text-center\">No farms available</Text>\n        <Text className=\"text-surface-500 text-sm mt-2 text-center\">\n          Add a farm to see weather data for your location\n        </Text>\n      </View>\n    );\n  }\n\n  const hasCoordinates = selectedFarm?.latitude && selectedFarm?.longitude;\n\n  return (\n    <ScrollView\n      className=\"flex-1 bg-surface-50\"\n      contentContainerStyle={{ padding: 16, paddingBottom: 32 }}\n      refreshControl={\n        <RefreshControl\n          refreshing={isRefetching}\n          onRefresh={refetch}\n          tintColor=\"#408059\"\n        />\n      }\n    >\n      {/* Farm Selector */}\n      <View className=\"mb-4\">\n        <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-2\">\n          FARM\n        </Text>\n        <TouchableOpacity\n          onPress={() => setShowFarmPicker(!showFarmPicker)}\n          className=\"bg-white rounded-xl p-4 flex-row items-center justify-between\"\n        >\n          <View className=\"flex-row items-center\">\n            <View className=\"w-10 h-10 rounded-xl bg-primary-100 items-center justify-center\">\n              <Ionicons name=\"leaf\" size={20} color=\"#408059\" />\n            </View>\n            <View className=\"ml-3\">\n              <Text className=\"text-base font-semibold text-surface-900\">\n                {selectedFarm?.name || 'Select Farm'}\n              </Text>\n              {hasCoordinates && (\n                <Text className=\"text-xs text-surface-500\">\n                  {selectedFarm?.latitude?.toFixed(4)}, {selectedFarm?.longitude?.toFixed(4)}\n                </Text>\n              )}\n            </View>\n          </View>\n          <Ionicons\n            name={showFarmPicker ? 'chevron-up' : 'chevron-down'}\n            size={20}\n            color=\"#9CA3AF\"\n          />\n        </TouchableOpacity>\n        {showFarmPicker && (\n          <View className=\"bg-white rounded-xl mt-2 overflow-hidden\">\n            {farms.map((farm) => (\n              <TouchableOpacity\n                key={farm.id}\n                onPress={() => {\n                  if (farm.id !== undefined) setSelectedFarmId(farm.id);\n                  setShowFarmPicker(false);\n                }}\n                className={`p-4 border-b border-surface-100 flex-row items-center ${\n                  selectedFarmId === farm.id ? 'bg-primary-50' : ''\n                }`}\n              >\n                <Text\n                  className={`flex-1 ${\n                    selectedFarmId === farm.id\n                      ? 'text-primary-700 font-semibold'\n                      : 'text-surface-700'\n                  }`}\n                >\n                  {farm.name}\n                </Text>\n                {selectedFarmId === farm.id && (\n                  <Ionicons name=\"checkmark\" size={20} color=\"#408059\" />\n                )}\n              </TouchableOpacity>\n            ))}\n          </View>\n        )}\n      </View>\n\n      {/* No coordinates warning */}\n      {!hasCoordinates && (\n        <View className=\"bg-amber-50 rounded-xl p-4 mb-4 flex-row items-start\">\n          <Ionicons name=\"warning\" size={20} color=\"#F59E0B\" />\n          <Text className=\"text-amber-800 text-sm ml-3 flex-1\">\n            This farm doesn't have location coordinates. Weather data is showing default\n            location (Nashik). Add GPS coordinates to get farm-specific weather.\n          </Text>\n        </View>\n      )}\n\n      {/* Settings Row */}\n      <View className=\"flex-row mb-4\" style={{ gap: 12 }}>\n        {/* Growth Stage Picker */}\n        <View className=\"flex-1\">\n          <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-2\">\n            GROWTH STAGE\n          </Text>\n          <TouchableOpacity\n            onPress={() => setShowGrowthPicker(!showGrowthPicker)}\n            className=\"bg-white rounded-xl p-3 flex-row items-center justify-between\"\n          >\n            <Text className=\"text-sm text-surface-900\" numberOfLines={1}>\n              {growthStage}\n            </Text>\n            <Ionicons name=\"chevron-down\" size={16} color=\"#9CA3AF\" />\n          </TouchableOpacity>\n          {showGrowthPicker && (\n            <View className=\"bg-white rounded-xl mt-2 absolute top-16 left-0 right-0 z-10 border border-gray-200\">\n              <ScrollView style={{ maxHeight: 200 }}>\n                {GROWTH_STAGES.map((stage) => (\n                  <TouchableOpacity\n                    key={stage}\n                    onPress={() => {\n                      setGrowthStage(stage);\n                      setShowGrowthPicker(false);\n                    }}\n                    className={`p-3 border-b border-surface-100 ${\n                      growthStage === stage ? 'bg-primary-50' : ''\n                    }`}\n                  >\n                    <Text\n                      className={\n                        growthStage === stage\n                          ? 'text-primary-700 font-medium'\n                          : 'text-surface-700'\n                      }\n                    >\n                      {stage}\n                    </Text>\n                  </TouchableOpacity>\n                ))}\n              </ScrollView>\n            </View>\n          )}\n        </View>\n\n        {/* Soil Type Picker */}\n        <View className=\"flex-1\">\n          <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-2\">\n            SOIL TYPE\n          </Text>\n          <TouchableOpacity\n            onPress={() => setShowSoilPicker(!showSoilPicker)}\n            className=\"bg-white rounded-xl p-3 flex-row items-center justify-between\"\n          >\n            <Text className=\"text-sm text-surface-900\" numberOfLines={1}>\n              {SOIL_TYPES.find((s) => s.value === soilType)?.label}\n            </Text>\n            <Ionicons name=\"chevron-down\" size={16} color=\"#9CA3AF\" />\n          </TouchableOpacity>\n          {showSoilPicker && (\n            <View className=\"bg-white rounded-xl mt-2 absolute top-16 left-0 right-0 z-10 border border-gray-200\">\n              {SOIL_TYPES.map((type) => (\n                <TouchableOpacity\n                  key={type.value}\n                  onPress={() => {\n                    setSoilType(type.value);\n                    setShowSoilPicker(false);\n                  }}\n                  className={`p-3 border-b border-surface-100 ${\n                    soilType === type.value ? 'bg-primary-50' : ''\n                  }`}\n                >\n                  <Text\n                    className={\n                      soilType === type.value\n                        ? 'text-primary-700 font-medium'\n                        : 'text-surface-700'\n                    }\n                  >\n                    {type.label}\n                  </Text>\n                </TouchableOpacity>\n              ))}\n            </View>\n          )}\n        </View>\n      </View>\n\n      {/* Current Weather Card */}\n      {weather && (\n        <View className=\"bg-primary-600 rounded-2xl p-5 mb-4\">\n          <View className=\"flex-row items-start justify-between\">\n            <View>\n              <Text className=\"text-primary-100 text-sm\">\n                {weather.location.name || 'Current Location'}\n              </Text>\n              <Text className=\"text-white text-5xl font-bold mt-1\">\n                {weather.current.temperature}°\n              </Text>\n              <Text className=\"text-primary-100 text-base mt-1\">\n                {weather.current.condition}\n              </Text>\n            </View>\n            <View className=\"items-end\">\n              <Ionicons\n                name={getWeatherIconName(weather.current.conditionCode)}\n                size={56}\n                color=\"rgba(255,255,255,0.9)\"\n              />\n              <Text className=\"text-primary-100 text-xs mt-2\">\n                Feels like {weather.current.feelsLike}°\n              </Text>\n            </View>\n          </View>\n          <View className=\"flex-row mt-4 pt-4 border-t border-primary-500\">\n            <View className=\"flex-1 items-center\">\n              <Ionicons name=\"water\" size={18} color=\"rgba(255,255,255,0.8)\" />\n              <Text className=\"text-white text-sm font-semibold mt-1\">\n                {weather.current.humidity}%\n              </Text>\n              <Text className=\"text-primary-200 text-xs\">Humidity</Text>\n            </View>\n            <View className=\"flex-1 items-center\">\n              <Ionicons name=\"speedometer\" size={18} color=\"rgba(255,255,255,0.8)\" />\n              <Text className=\"text-white text-sm font-semibold mt-1\">\n                {weather.current.windSpeed} km/h\n              </Text>\n              <Text className=\"text-primary-200 text-xs\">Wind</Text>\n            </View>\n            <View className=\"flex-1 items-center\">\n              <Ionicons name=\"sunny\" size={18} color=\"rgba(255,255,255,0.8)\" />\n              <Text className=\"text-white text-sm font-semibold mt-1\">\n                {weather.current.uvIndex}\n              </Text>\n              <Text className=\"text-primary-200 text-xs\">UV Index</Text>\n            </View>\n            <View className=\"flex-1 items-center\">\n              <Ionicons name=\"rainy\" size={18} color=\"rgba(255,255,255,0.8)\" />\n              <Text className=\"text-white text-sm font-semibold mt-1\">\n                {weather.current.precipitation} mm\n              </Text>\n              <Text className=\"text-primary-200 text-xs\">Rain</Text>\n            </View>\n          </View>\n        </View>\n      )}\n\n      {/* 7-Day Forecast */}\n      {weather && (\n        <View className=\"mb-4\">\n          <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-3\">\n            7-DAY FORECAST\n          </Text>\n          <ScrollView\n            horizontal\n            showsHorizontalScrollIndicator={false}\n            contentContainerStyle={{ gap: 10 }}\n          >\n            {weather.forecast.map((day, index) => (\n              <View\n                key={day.date}\n                className={`bg-white rounded-xl p-3 items-center ${\n                  index === 0 ? 'border-2 border-primary-500' : ''\n                }`}\n                style={{ width: 80 }}\n              >\n                <Text\n                  className={`text-xs font-semibold ${\n                    index === 0 ? 'text-primary-600' : 'text-surface-600'\n                  }`}\n                >\n                  {getDayName(day.date)}\n                </Text>\n                <Ionicons\n                  name={getWeatherIconName(day.conditionCode)}\n                  size={28}\n                  color={index === 0 ? '#408059' : '#6B7280'}\n                  style={{ marginVertical: 8 }}\n                />\n                <Text className=\"text-sm font-bold text-surface-900\">\n                  {day.maxTemp}°\n                </Text>\n                <Text className=\"text-xs text-surface-500\">{day.minTemp}°</Text>\n                {day.precipitationProbability > 0 && (\n                  <View className=\"flex-row items-center mt-1\">\n                    <Ionicons name=\"water\" size={10} color=\"#3B82F6\" />\n                    <Text className=\"text-xs text-blue-600 ml-0.5\">\n                      {day.precipitationProbability}%\n                    </Text>\n                  </View>\n                )}\n              </View>\n            ))}\n          </ScrollView>\n        </View>\n      )}\n\n      {/* ETc & Irrigation Card */}\n      {etc && (\n        <View className=\"bg-white rounded-2xl p-4 mb-4\">\n          <View className=\"flex-row items-center mb-3\">\n            <View className=\"w-10 h-10 rounded-xl bg-blue-100 items-center justify-center\">\n              <Ionicons name=\"water\" size={20} color=\"#3B82F6\" />\n            </View>\n            <Text className=\"text-base font-semibold text-surface-900 ml-3\">\n              Water Requirements\n            </Text>\n          </View>\n          <View className=\"flex-row flex-wrap\" style={{ gap: 12 }}>\n            <View className=\"bg-surface-50 rounded-xl p-3 flex-1\" style={{ minWidth: '45%' }}>\n              <Text className=\"text-xs text-surface-500\">Daily ETc</Text>\n              <Text className=\"text-xl font-bold text-surface-900\">{etc.dailyETc} mm</Text>\n              <Text className=\"text-xs text-surface-500\">Kc: {etc.cropCoefficient}</Text>\n            </View>\n            <View className=\"bg-surface-50 rounded-xl p-3 flex-1\" style={{ minWidth: '45%' }}>\n              <Text className=\"text-xs text-surface-500\">Weekly Need</Text>\n              <Text className=\"text-xl font-bold text-surface-900\">{etc.weeklyETc} mm</Text>\n              <Text className=\"text-xs text-surface-500\">ET₀: {etc.referenceET} mm</Text>\n            </View>\n            {irrigationSchedule && (\n              <View className=\"bg-blue-50 rounded-xl p-3 flex-1\" style={{ minWidth: '45%' }}>\n                <Text className=\"text-xs text-blue-600\">Total (7 days)</Text>\n                <Text className=\"text-xl font-bold text-blue-700\">\n                  {irrigationSchedule.totalWaterNeed} mm\n                </Text>\n                <Text className=\"text-xs text-blue-600\">\n                  {irrigationSchedule.schedule.length} irrigations\n                </Text>\n              </View>\n            )}\n          </View>\n        </View>\n      )}\n\n      {/* Weather Alerts */}\n      {alerts && (\n        <View className=\"mb-4\">\n          <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-3\">\n            ALERTS & RECOMMENDATIONS\n          </Text>\n\n          {/* Irrigation Alert */}\n          <View className=\"bg-white rounded-2xl p-4 mb-3\">\n            <View className=\"flex-row items-center justify-between mb-2\">\n              <View className=\"flex-row items-center\">\n                <View className=\"w-8 h-8 rounded-lg bg-blue-100 items-center justify-center\">\n                  <Ionicons name=\"water\" size={16} color=\"#3B82F6\" />\n                </View>\n                <Text className=\"text-sm font-semibold text-surface-900 ml-2\">\n                  Irrigation\n                </Text>\n              </View>\n              <View\n                className=\"px-2 py-1 rounded-full\"\n                style={{ backgroundColor: urgencyColors[alerts.irrigation.urgency].bg }}\n              >\n                <Text\n                  className=\"text-xs font-medium\"\n                  style={{ color: urgencyColors[alerts.irrigation.urgency].text }}\n                >\n                  {alerts.irrigation.urgency.toUpperCase()}\n                </Text>\n              </View>\n            </View>\n            <Text className=\"text-sm text-surface-700\">{alerts.irrigation.reason}</Text>\n            {alerts.irrigation.recommendations.map((rec, i) => (\n              <View key={i} className=\"flex-row items-start mt-2\">\n                <Ionicons name=\"checkmark-circle\" size={14} color=\"#408059\" />\n                <Text className=\"text-xs text-surface-600 ml-2 flex-1\">{rec}</Text>\n              </View>\n            ))}\n          </View>\n\n          {/* Pest Alert */}\n          <View className=\"bg-white rounded-2xl p-4 mb-3\">\n            <View className=\"flex-row items-center justify-between mb-2\">\n              <View className=\"flex-row items-center\">\n                <View className=\"w-8 h-8 rounded-lg bg-orange-100 items-center justify-center\">\n                  <Ionicons name=\"bug\" size={16} color=\"#F59E0B\" />\n                </View>\n                <Text className=\"text-sm font-semibold text-surface-900 ml-2\">\n                  Pest & Disease\n                </Text>\n              </View>\n              <View\n                className=\"px-2 py-1 rounded-full\"\n                style={{ backgroundColor: urgencyColors[alerts.pest.riskLevel].bg }}\n              >\n                <Text\n                  className=\"text-xs font-medium\"\n                  style={{ color: urgencyColors[alerts.pest.riskLevel].text }}\n                >\n                  {alerts.pest.riskLevel.toUpperCase()} RISK\n                </Text>\n              </View>\n            </View>\n            {alerts.pest.conditions.map((cond, i) => (\n              <Text key={i} className=\"text-sm text-surface-700\">\n                {cond}\n              </Text>\n            ))}\n            {alerts.pest.precautions.map((prec, i) => (\n              <View key={i} className=\"flex-row items-start mt-2\">\n                <Ionicons name=\"shield-checkmark\" size={14} color=\"#F59E0B\" />\n                <Text className=\"text-xs text-surface-600 ml-2 flex-1\">{prec}</Text>\n              </View>\n            ))}\n          </View>\n\n          {/* Harvest Alert */}\n          <View className=\"bg-white rounded-2xl p-4\">\n            <View className=\"flex-row items-center justify-between mb-2\">\n              <View className=\"flex-row items-center\">\n                <View className=\"w-8 h-8 rounded-lg bg-purple-100 items-center justify-center\">\n                  <Ionicons name=\"basket\" size={16} color=\"#8B5CF6\" />\n                </View>\n                <Text className=\"text-sm font-semibold text-surface-900 ml-2\">\n                  Harvest Conditions\n                </Text>\n              </View>\n              <View\n                className=\"px-2 py-1 rounded-full\"\n                style={{\n                  backgroundColor: alerts.harvest.isOptimal ? '#DCFCE7' : '#FEF3C7',\n                }}\n              >\n                <Text\n                  className=\"text-xs font-medium\"\n                  style={{ color: alerts.harvest.isOptimal ? '#166534' : '#92400E' }}\n                >\n                  {alerts.harvest.isOptimal ? 'OPTIMAL' : 'MODERATE'}\n                </Text>\n              </View>\n            </View>\n            <Text className=\"text-sm text-surface-700\">{alerts.harvest.conditions}</Text>\n            {alerts.harvest.recommendations.map((rec, i) => (\n              <View key={i} className=\"flex-row items-start mt-2\">\n                <Ionicons name=\"checkmark-circle\" size={14} color=\"#8B5CF6\" />\n                <Text className=\"text-xs text-surface-600 ml-2 flex-1\">{rec}</Text>\n              </View>\n            ))}\n          </View>\n        </View>\n      )}\n\n      {/* Irrigation Schedule */}\n      {irrigationSchedule && irrigationSchedule.schedule.length > 0 && (\n        <View className=\"mb-4\">\n          <Text className=\"text-xs font-bold text-surface-500 tracking-wider mb-3\">\n            IRRIGATION SCHEDULE\n          </Text>\n          {irrigationSchedule.schedule.map((item, i) => (\n            <View key={i} className=\"bg-white rounded-xl p-4 mb-2 flex-row items-center\">\n              <View\n                className=\"w-10 h-10 rounded-xl items-center justify-center\"\n                style={{\n                  backgroundColor:\n                    item.priority === 'high'\n                      ? '#FEE2E2'\n                      : item.priority === 'medium'\n                      ? '#FEF3C7'\n                      : '#DCFCE7',\n                }}\n              >\n                <Ionicons\n                  name=\"water\"\n                  size={20}\n                  color={\n                    item.priority === 'high'\n                      ? '#DC2626'\n                      : item.priority === 'medium'\n                      ? '#D97706'\n                      : '#16A34A'\n                  }\n                />\n              </View>\n              <View className=\"flex-1 ml-3\">\n                <Text className=\"text-sm font-semibold text-surface-900\">\n                  {getDayName(item.date)} - {item.amount} mm\n                </Text>\n                <Text className=\"text-xs text-surface-500\">\n                  {item.duration.toFixed(1)} hours • {item.reason}\n                </Text>\n              </View>\n              <View\n                className=\"px-2 py-1 rounded-full\"\n                style={{ backgroundColor: urgencyColors[item.priority].bg }}\n              >\n                <Text\n                  className=\"text-xs font-medium\"\n                  style={{ color: urgencyColors[item.priority].text }}\n                >\n                  {item.priority.toUpperCase()}\n                </Text>\n              </View>\n            </View>\n          ))}\n        </View>\n      )}\n\n      {/* Last Updated */}\n      {weather && (\n        <View className=\"items-center mt-2\">\n          <Text className=\"text-xs text-surface-400\">\n            Last updated: {new Date(weather.lastUpdated).toLocaleTimeString()}\n          </Text>\n        </View>\n      )}\n    </ScrollView>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/ashishhuddar/Desktop/vinesight-rn/eslint.config.js","messages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":1,"column":12,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":1,"endColumn":33},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":2,"column":24,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":2,"endColumn":51},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":3,"column":26,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":3,"endColumn":69},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":4,"column":26,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":4,"endColumn":62},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":5,"column":21,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":5,"endColumn":51},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":6,"column":26,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":6,"endColumn":62},{"ruleId":"@typescript-eslint/no-require-imports","severity":2,"message":"A `require()` style import is forbidden.","line":7,"column":27,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":7,"endColumn":64},{"ruleId":"@typescript-eslint/no-require-imports",