nRecord;\n      const fertCount = fertigation.fertilizers?.length || 0;\n      return `${fertCount} fertilizer${fertCount !== 1 ? 's' : ''} applied`;\n    default:\n      return '';\n  }\n}\n\nexport function ActivityLogCard({\n  type,\n  date,\n  description,\n  data,\n  farmName,\n  onPress,\n}: ActivityLogCardProps) {\n  const logType = getLogType(type);\n  const parsedDate = fromSupabaseDateString(date);\n  const displayDescription = description || getDescriptionFromData(type, data);\n  const displayDate = parsedDate\n    ? parsedDate.toLocaleDateString('en-US', {\n        month: 'short',\n        day: 'numeric',\n      })\n    : date;\n\n  const content = (\n    <View \n      className=\"flex-row items-center rounded-xl px-3 py-2\"\n      style={{ \n        backgroundColor: '#ffffff',\n      }}\n    >\n      {/* Icon */}\n      <View\n        className=\"w-10 h-10 rounded-full items-center justify-center mr-3\"\n        style={{ backgroundColor: `${logType.color}26` }}\n      >\n        <Ionicons\n          name={logType.icon as keyof typeof Ionicons.glyphMap}\n          size={18}\n          color={logType.color}\n        />\n      </View>\n\n      {/* Content */}\n      <View className=\"flex-1\">\n        <Text className=\"text-sm font-semibold\" style={{ color: '#000000' }} numberOfLines={1}>\n          {displayDescription || logType.label}\n        </Text>\n        <View className=\"flex-row items-center mt-1\">\n          {farmName && (\n            <>\n              <Text className=\"text-xs\" style={{ color: '#8e8e93' }}>\n                {farmName}\n              </Text>\n              <Text className=\"text-xs mx-1\" style={{ color: '#c7c7cc' }}>\n                •\n              </Text>\n            </>\n          )}\n          <Text className=\"text-xs\" style={{ color: '#c7c7cc' }}>\n            {displayDate}\n          </Text>\n        </View>\n      </View>\n\n      {/* Chevron */}\n      <Ionicons name=\"chevron-forward\" size={16} color=\"#c7c7cc\" />\n    </View>\n  );\n\n  if (onPress) {\n    return (\n      <Pressable onPress={onPress} className=\"active:opacity-80\">\n        {content}\n      </Pressable>\n    );\n  }\n\n  return content;\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/ashishhuddar/Desktop/vinesight-rn/src/components/cards/FarmCard.tsx","messages":[{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  backgroundColor: '#ffffff',\n  shadowColor: '#000000',\n  shadowOpacity: 0.05,\n  shadowRadius: 3,\n  elevation: 1\n}","line":29,"column":14,"nodeType":"ObjectExpression","endLine":36,"endColumn":8},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { backgroundColor: '#ffffff', shadowColor: '#000000' }","line":29,"column":14,"nodeType":"ObjectExpression","endLine":36,"endColumn":8},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: '#000000' }","line":42,"column":18,"nodeType":"ObjectExpression","endLine":42,"endColumn":38},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: '#000000' }","line":42,"column":18,"nodeType":"ObjectExpression","endLine":42,"endColumn":38},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":49,"column":28,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":49,"endColumn":31,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1497,1500],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[1497,1500],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { backgroundColor: 'rgba(64, 128, 89, 0.1)' }","line":54,"column":22,"nodeType":"ObjectExpression